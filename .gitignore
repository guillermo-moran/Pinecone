# ====================================================================
# Xcode / iOS Core Files
# ====================================================================

# Build generated binaries and data
build/
DerivedData/
.DerivedData/
.DerivedDataAutoInit/
.DerivedData*/
/artifacts/

# Local HOME used by sandboxed Xcode/SwiftPM builds (caches and symlinks)
.sandbox-home/
.sandbox-home-*/

# Xcode test results, archives, and exported apps
*.xcresult/
*.xcarchive/
*.ipa
*.app/

# Compiled native/graphics dependencies; keep their source and build scripts
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.framework/
*.xcframework/
*.air
*.metallib
*.metal-ar

# Personal Xcode user preferences (window layouts, open tabs)
xcuserdata/

# Architecture-specific symbol files
*.dSYM
*.dSYM.zip

# Xcode State & SCM metadata
*.moved-aside
*.xccheckout
*.xcscmblueprint

# ====================================================================
# macOS Specific Files
# ====================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ====================================================================
# Package Managers & Dependencies
# ====================================================================

# Swift Package Manager (SPM)
# Ignore local build artifacts but KEEP Package.resolved to lock versions
.build/

# Python tooling and regression-test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Compiler coverage/profiling output, not curated benchmark reports
*.profraw
*.profdata
*.gcda
*.gcno

# CocoaPods
# Un-comment Pods/ if you prefer to download them fresh on every machine
# Pods/

# Carthage
Carthage/Build/

# ====================================================================
# Tools & Automation
# ====================================================================

# Fastlane (Ignore local execution artifacts)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Local configuration / Environment variables
.env
.env.*
!.env.example
!.env.sample

# Local signing identities and provisioning profiles; keep public build keys
*.p12
*.pfx
*.p8
*.mobileprovision
*.provisionprofile

# ====================================================================
# Guest Images & Local Run Output
# ====================================================================

# Downloaded, generated, and writable VM disks (including compressed copies)
*.img
*.img.*
*.raw
*.raw.*
*.qcow
*.qcow.*
*.qcow2
*.qcow2.*
*.vmdk
*.vdi
*.sparseimage
*.sparsebundle/

# Allow deliberately maintained small image fixtures in test fixture folders
!Tests/**/Fixtures/**/*.img
!Tests/**/Fixtures/**/*.raw
!Tests/**/Fixtures/**/*.qcow2

# Android build output accidentally directed into the repository root
/out/

# Ad-hoc captures in the root; curated experiment evidence remains visible
/pinecone-*.log
/pinecone-*.json
/xcodebuild*.log
/swift-test*.log

# Do not blanket-ignore logs, JSON, PNG, or archives: curated evidence in
# experiments/ and docs/performance-evidence/ is intentionally versioned.
