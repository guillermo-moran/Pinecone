#!/bin/sh
set -u

LOG_DIR=/var/log/pinecone
SESSION_LOG="${LOG_DIR}/phosh-session.log"
mkdir -p "$LOG_DIR"
: > "$SESSION_LOG"

printf '%s\n' 'pinecone-phosh: starting Phosh shell' >> "$SESSION_LOG"

# Phoc sets WAYLAND_DISPLAY before executing this supervisor. Propagate that
# final compositor environment to services activated by the session bus.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_RUNTIME_DIR \
    XDG_SESSION_TYPE \
    2>>"$SESSION_LOG" || true
fi

if [ -f /usr/share/pinecone/phosh-ui/lockscreen.ui ]; then
  export G_RESOURCE_OVERLAYS=/mobi/phosh/ui=/usr/share/pinecone/phosh-ui
fi

OSK_PID=
if command -v squeekboard >/dev/null 2>&1; then
  # Squeekboard has a substantial GTK startup cost. Starting it beside Phosh
  # makes both processes contend for the interpreted guest CPU before the
  # first shell frame. The lock screen does not need text input, so defer the
  # OSK until Phosh has had an uncontested startup window.
  (
    sleep "${PINECONE_OSK_START_DELAY_SECONDS:-60}"
    exec squeekboard
  ) >>"$SESSION_LOG" 2>&1 &
  OSK_PID=$!
fi

set -o pipefail 2>/dev/null || true
/usr/libexec/phosh >> "$SESSION_LOG" 2>&1
status=$?

if [ -n "$OSK_PID" ]; then
  kill "$OSK_PID" 2>/dev/null || true
  wait "$OSK_PID" 2>/dev/null || true
fi

printf 'pinecone-phosh: shell exited with status %s\n' "$status" >> "$SESSION_LOG"
exit "$status"
