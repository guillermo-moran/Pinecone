+#ifndef RENDER_PIXMAN_DMABUF_H
+#define RENDER_PIXMAN_DMABUF_H
+
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/drm_format_set.h>
+
+bool pixman_dmabuf_add_formats(struct wlr_drm_format_set *formats);
+int pixman_dmabuf_open_device(int drm_fd);
+bool pixman_dmabuf_check_import(int drm_fd, const struct wlr_dmabuf_attributes *a);
+struct wlr_buffer *pixman_dmabuf_import(int drm_fd, struct wlr_buffer *source);
+bool pixman_dmabuf_buffer_ok(struct wlr_buffer *buffer);
+bool pixman_dmabuf_buffer_is_imported(struct wlr_buffer *buffer);
+
+// Only for constructing an image; pixel reads still require begin/end access.
+void pixman_dmabuf_get_mapping(struct wlr_buffer *buffer,
+	void **data, uint32_t *format, size_t *stride);
+struct wlr_surface;
+bool pixman_dmabuf_lock_surface(struct wlr_surface *surface);
+
+#endif
--- a/render/pixman/dmabuf.c
+++ b/render/pixman/dmabuf.c
@@ -0,0 +1,333 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <linux/dma-buf.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <wlr/util/log.h>
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+#include "render/pixman_dmabuf.h"
+
+static const uint32_t import_formats[] = {
+	DRM_FORMAT_XRGB8888, DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XBGR8888, DRM_FORMAT_ABGR8888,
+};
+
+struct pixman_dmabuf_buffer {
+	struct wlr_buffer base;
+	struct wlr_buffer *source;
+	int drm_fd, prime_fd;
+	uint32_t handle, format, stride, offset;
+	void *mapping;
+	size_t length;
+	bool accessing, failed;
+};
+
+static const struct wlr_buffer_impl dmabuf_impl;
+
+bool pixman_dmabuf_add_formats(struct wlr_drm_format_set *formats) {
+	for (size_t i = 0; i < sizeof(import_formats) / sizeof(import_formats[0]); i++) {
+		if (!wlr_drm_format_set_add(formats, import_formats[i], DRM_FORMAT_MOD_LINEAR)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool validate_attributes(const struct wlr_dmabuf_attributes *a,
+		size_t *length) {
+	bool supported = false;
+	for (size_t i = 0; i < sizeof(import_formats) / sizeof(import_formats[0]); i++) {
+		supported |= a->format == import_formats[i];
+	}
+	// INVALID is an unknown vendor layout, not a synonym for LINEAR.
+	if (!supported || a->modifier != DRM_FORMAT_MOD_LINEAR || a->n_planes != 1 ||
+			a->fd[0] < 0 || a->width <= 0 || a->height <= 0 ||
+			a->width > INT16_MAX || a->height > INT16_MAX ||
+			a->stride[0] > INT32_MAX || (a->stride[0] & 3) || (a->offset[0] & 3) ||
+			a->stride[0] < (uint32_t)a->width * 4) {
+		return false;
+	}
+	// Include the last row's padding: the bridge registers stride * height.
+	uint64_t end = (uint64_t)a->offset[0] + (uint64_t)a->stride[0] * a->height;
+	if (end > SIZE_MAX || end > PTRDIFF_MAX) {
+		return false;
+	}
+	*length = (size_t)end;
+	return true;
+}
+
+static int reopen_device(int fd) {
+	// MAP_DUMB is a primary-node ioctl. Do not advertise it on a render node.
+	if (fd < 0 || drmGetNodeTypeFromFd(fd) != DRM_NODE_PRIMARY) {
+		return -1;
+	}
+	char *name = drmGetDeviceNameFromFd2(fd);
+	if (name == NULL) {
+		return -1;
+	}
+	// A dup shares GEM handles without reference counts. Each import needs a
+	// new DRM file so closing its handle cannot invalidate another import.
+	int new_fd = open(name, O_RDWR | O_CLOEXEC);
+	free(name);
+	if (new_fd < 0) {
+		return -1;
+	}
+	struct stat old_stat, new_stat;
+	if (fstat(fd, &old_stat) < 0 || fstat(new_fd, &new_stat) < 0 ||
+			!S_ISCHR(new_stat.st_mode) || old_stat.st_rdev != new_stat.st_rdev) {
+		close(new_fd);
+		return -1;
+	}
+	return new_fd;
+}
+
+static bool sync_read(struct pixman_dmabuf_buffer *buffer, uint64_t phase) {
+	struct dma_buf_sync sync = { .flags = DMA_BUF_SYNC_READ | phase };
+	// A bad exporter must not spin the compositor indefinitely on EAGAIN.
+	for (unsigned int attempt = 0; attempt < 8; attempt++) {
+		if (ioctl(buffer->prime_fd, DMA_BUF_IOCTL_SYNC, &sync) == 0) {
+			return true;
+		}
+		if (errno != EINTR && errno != EAGAIN) {
+			return false;
+		}
+	}
+	return false;
+}
+
+static bool begin_read(struct pixman_dmabuf_buffer *buffer) {
+	if (buffer->failed || buffer->accessing) {
+		return false;
+	}
+	// SYNC provides cache coherency, not a producer completion guarantee.
+	struct pollfd pfd = { .fd = buffer->prime_fd, .events = POLLIN };
+	int ret = -1;
+	for (unsigned int attempt = 0; attempt < 8; attempt++) {
+		// Never block the Wayland event loop on a client-controlled fence.
+		ret = poll(&pfd, 1, 0);
+		if (ret >= 0 || (errno != EINTR && errno != EAGAIN)) {
+			break;
+		}
+	}
+	if (ret == 0 || (ret < 0 && (errno == EINTR || errno == EAGAIN))) {
+		return false; // Retry on a later access; never expose unready pixels.
+	}
+	if (ret != 1 || !(pfd.revents & POLLIN) ||
+			(pfd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+		buffer->failed = true;
+		return false;
+	}
+	if (!sync_read(buffer, DMA_BUF_SYNC_START)) {
+		buffer->failed = errno != EINTR && errno != EAGAIN;
+		return false;
+	}
+	buffer->accessing = true;
+	return true;
+}
+
+static bool end_read(struct pixman_dmabuf_buffer *buffer) {
+	assert(buffer->accessing);
+	buffer->accessing = false;
+	if (!sync_read(buffer, DMA_BUF_SYNC_END)) {
+		buffer->failed = true;
+		wlr_log_errno(WLR_ERROR, "Pixman DMA-BUF END READ failed");
+	}
+	return !buffer->failed;
+}
+
+static bool finish_mapping(struct pixman_dmabuf_buffer *buffer) {
+	if (buffer->accessing) {
+		end_read(buffer);
+	}
+	// The bridge can reject unmapping after a failed completion fence. Retain
+	// all backing resources in that case, rather than release a live buffer.
+	if (buffer->mapping != MAP_FAILED &&
+			munmap(buffer->mapping, buffer->length) < 0) {
+		wlr_log_errno(WLR_ERROR, "Retaining DMA-BUF after failed unmap fence");
+		return false;
+	}
+	if (buffer->handle != 0) {
+		drmCloseBufferHandle(buffer->drm_fd, buffer->handle);
+	}
+	if (buffer->drm_fd >= 0) {
+		close(buffer->drm_fd);
+	}
+	if (buffer->prime_fd >= 0) {
+		close(buffer->prime_fd);
+	}
+	wlr_buffer_unlock(buffer->source);
+	free(buffer);
+	return true;
+}
+
+static struct pixman_dmabuf_buffer *map_attributes(int drm_fd,
+		const struct wlr_dmabuf_attributes *a) {
+	size_t length;
+	if (!validate_attributes(a, &length)) {
+		return NULL;
+	}
+	struct pixman_dmabuf_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+	buffer->prime_fd = -1;
+	buffer->drm_fd = -1;
+	buffer->mapping = MAP_FAILED;
+	buffer->length = length;
+	buffer->format = a->format;
+	buffer->stride = a->stride[0];
+	buffer->offset = a->offset[0];
+	buffer->prime_fd = fcntl(a->fd[0], F_DUPFD_CLOEXEC, 0);
+	if (buffer->prime_fd < 0) {
+		goto error;
+	}
+	off_t size = lseek(buffer->prime_fd, 0, SEEK_END);
+	if (size < 0 || lseek(buffer->prime_fd, 0, SEEK_SET) < 0 ||
+			(uint64_t)size < length) {
+		goto error;
+	}
+	buffer->drm_fd = reopen_device(drm_fd);
+	if (buffer->drm_fd < 0 ||
+			drmPrimeFDToHandle(buffer->drm_fd, buffer->prime_fd, &buffer->handle) != 0) {
+		goto error;
+	}
+	uint64_t offset;
+	if (drmModeMapDumbBuffer(buffer->drm_fd, buffer->handle, &offset) != 0 ||
+			offset > INT64_MAX || (uint64_t)(off_t)offset != offset) {
+		goto error;
+	}
+	buffer->mapping = mmap(NULL, length, PROT_READ, MAP_SHARED, buffer->drm_fd, offset);
+	if (buffer->mapping == MAP_FAILED) {
+		goto error;
+	}
+	return buffer;
+
+error:
+	finish_mapping(buffer);
+	return NULL;
+}
+
+static void buffer_destroy(struct wlr_buffer *base) {
+	struct pixman_dmabuf_buffer *buffer = wl_container_of(base, buffer, base);
+	wlr_buffer_finish(base);
+	finish_mapping(buffer);
+}
+
+bool pixman_dmabuf_check_import(int drm_fd, const struct wlr_dmabuf_attributes *a) {
+	// Protocol creation checks layout and mapping, not producer readiness. It
+	// must not wait for client fences or touch pixels before an actual read.
+	struct pixman_dmabuf_buffer *buffer = map_attributes(drm_fd, a);
+	return buffer != NULL && finish_mapping(buffer);
+}
+
+static bool buffer_begin_access(struct wlr_buffer *base, uint32_t flags,
+		void **data, uint32_t *format, size_t *stride) {
+	struct pixman_dmabuf_buffer *buffer = wl_container_of(base, buffer, base);
+	if (flags != WLR_BUFFER_DATA_PTR_ACCESS_READ || !begin_read(buffer)) {
+		return false;
+	}
+	*data = (char *)buffer->mapping + buffer->offset;
+	*format = buffer->format;
+	*stride = buffer->stride;
+	return true;
+}
+
+static void buffer_end_access(struct wlr_buffer *base) {
+	struct pixman_dmabuf_buffer *buffer = wl_container_of(base, buffer, base);
+	end_read(buffer);
+}
+
+static const struct wlr_buffer_impl dmabuf_impl = {
+	.destroy = buffer_destroy,
+	.begin_data_ptr_access = buffer_begin_access,
+	.end_data_ptr_access = buffer_end_access,
+};
+
+bool pixman_dmabuf_buffer_is_imported(struct wlr_buffer *buffer) {
+	return buffer != NULL && buffer->impl == &dmabuf_impl;
+}
+
+void pixman_dmabuf_get_mapping(struct wlr_buffer *base,
+		void **data, uint32_t *format, size_t *stride) {
+	assert(pixman_dmabuf_buffer_is_imported(base));
+	struct pixman_dmabuf_buffer *buffer = wl_container_of(base, buffer, base);
+	*data = (char *)buffer->mapping + buffer->offset;
+	*format = buffer->format;
+	*stride = buffer->stride;
+}
+
+bool pixman_dmabuf_buffer_ok(struct wlr_buffer *base) {
+	if (!pixman_dmabuf_buffer_is_imported(base)) {
+		return true;
+	}
+	struct pixman_dmabuf_buffer *buffer = wl_container_of(base, buffer, base);
+	return !buffer->failed;
+}
+
+struct wlr_buffer *pixman_dmabuf_import(int drm_fd, struct wlr_buffer *source) {
+	struct wlr_dmabuf_attributes a;
+	if (drm_fd < 0 || !wlr_buffer_get_dmabuf(source, &a) ||
+			a.width != source->width || a.height != source->height) {
+		return NULL;
+	}
+	struct pixman_dmabuf_buffer *buffer = map_attributes(drm_fd, &a);
+	if (buffer == NULL) {
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &dmabuf_impl, a.width, a.height);
+	buffer->source = wlr_buffer_lock(source);
+	return &buffer->base;
+}
+
+int pixman_dmabuf_open_device(int drm_fd) {
+	int fd = reopen_device(drm_fd);
+	if (fd < 0) {
+		return -1;
+	}
+	uint64_t caps = 0;
+	if (drmGetCap(fd, DRM_CAP_PRIME, &caps) < 0 || !(caps & DRM_PRIME_CAP_IMPORT)) {
+		close(fd);
+		return -1;
+	}
+	// Prove the selected node's complete import path before advertising it.
+	uint32_t handle = 0, stride;
+	uint64_t size;
+	int prime_fd = -1;
+	bool ok = false;
+	if (drmModeCreateDumbBuffer(fd, 1, 1, 32, 0, &handle, &stride, &size) == 0 &&
+			drmPrimeHandleToFD(fd, handle, DRM_CLOEXEC, &prime_fd) == 0) {
+		struct wlr_dmabuf_attributes a = {
+			.width = 1, .height = 1, .format = DRM_FORMAT_XRGB8888,
+			.modifier = DRM_FORMAT_MOD_LINEAR, .n_planes = 1,
+			.fd = { prime_fd }, .stride = { stride },
+		};
+		struct pixman_dmabuf_buffer *buffer = map_attributes(fd, &a);
+		if (buffer != NULL) {
+			ok = begin_read(buffer);
+			if (ok) {
+				ok = end_read(buffer);
+			}
+			ok = finish_mapping(buffer) && ok;
+		}
+	}
+	if (prime_fd >= 0) {
+		close(prime_fd);
+	}
+	if (handle != 0) {
+		drmModeDestroyDumbBuffer(fd, handle);
+	}
+	if (!ok) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
--- a/render/pixman/dmabuf_wait.c
+++ b/render/pixman/dmabuf_wait.c
@@ -0,0 +1,188 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <wayland-server-core.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/pixman.h>
+#include <wlr/types/wlr_compositor.h>
+#include "render/pixman_dmabuf.h"
+
+struct pixman_dmabuf_wait {
+	struct wlr_surface *surface;
+	struct wlr_renderer *renderer;
+	struct wl_event_loop *loop;
+	struct wl_event_source *fd_source, *timer;
+	struct wl_listener surface_destroy, renderer_destroy, renderer_lost;
+	uint32_t seq;
+	int fd, retry_ms;
+};
+
+// -2 is an interrupted check, not readiness. Retrying it is timer-paced so a
+// readable fd plus repeated EINTR/EAGAIN cannot spin the Wayland event loop.
+static int dmabuf_read_ready(int fd) {
+	struct pollfd pfd = { .fd = fd, .events = POLLIN };
+	int ret = poll(&pfd, 1, 0);
+	if (ret < 0) {
+		return errno == EINTR || errno == EAGAIN ? -2 : -1;
+	}
+	if (ret == 0) {
+		return 0;
+	}
+	if (ret != 1 || !(pfd.revents & POLLIN) ||
+			(pfd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+		return -1;
+	}
+	return 1;
+}
+
+static void dmabuf_wait_destroy(struct pixman_dmabuf_wait *wait) {
+	if (wait->fd_source != NULL) {
+		wl_event_source_remove(wait->fd_source);
+	}
+	if (wait->timer != NULL) {
+		wl_event_source_remove(wait->timer);
+	}
+	wl_list_remove(&wait->surface_destroy.link);
+	wl_list_remove(&wait->renderer_destroy.link);
+	wl_list_remove(&wait->renderer_lost.link);
+	close(wait->fd);
+	free(wait);
+}
+
+static void dmabuf_wait_fail(struct pixman_dmabuf_wait *wait) {
+	wl_client_post_implementation_error(wl_resource_get_client(wait->surface->resource),
+		"Pixman DMA-BUF producer fence failed or renderer was reset");
+	// Do not unlock an unsignaled commit. Client teardown destroys its cached
+	// states and releases their buffers without importing or presenting them.
+	dmabuf_wait_destroy(wait);
+}
+
+static void dmabuf_wait_surface_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct pixman_dmabuf_wait *wait = wl_container_of(listener, wait, surface_destroy);
+	// In particular, don't call unlock_cached here: it may apply cached states
+	// and emit commit callbacks while the surface is being destroyed.
+	dmabuf_wait_destroy(wait);
+}
+
+static void dmabuf_wait_renderer_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct pixman_dmabuf_wait *wait = wl_container_of(listener, wait, renderer_destroy);
+	dmabuf_wait_fail(wait);
+}
+
+static void dmabuf_wait_renderer_lost(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct pixman_dmabuf_wait *wait = wl_container_of(listener, wait, renderer_lost);
+	dmabuf_wait_fail(wait);
+}
+
+static int dmabuf_wait_fd(int fd, uint32_t mask, void *data);
+static int dmabuf_wait_timer(void *data);
+
+static bool dmabuf_wait_arm(struct pixman_dmabuf_wait *wait, int ready) {
+	if (ready == 0) {
+		wait->retry_ms = 0;
+		if (wait->fd_source == NULL) {
+			wait->fd_source = wl_event_loop_add_fd(wait->loop, wait->fd,
+				WL_EVENT_READABLE, dmabuf_wait_fd, wait);
+		}
+		return wait->fd_source != NULL;
+	}
+	if (wait->fd_source != NULL) {
+		wl_event_source_remove(wait->fd_source);
+		wait->fd_source = NULL;
+	}
+	if (wait->timer == NULL) {
+		wait->timer = wl_event_loop_add_timer(wait->loop, dmabuf_wait_timer, wait);
+	}
+	wait->retry_ms = wait->retry_ms == 0 ? 16 : wait->retry_ms * 2;
+	if (wait->retry_ms > 250) {
+		wait->retry_ms = 250;
+	}
+	return wait->timer != NULL && wl_event_source_timer_update(wait->timer, wait->retry_ms) == 0;
+}
+
+static void dmabuf_wait_check(struct pixman_dmabuf_wait *wait, bool failed) {
+	int ready = failed ? -1 : dmabuf_read_ready(wait->fd);
+	if (ready == -1 || wait->surface->compositor->renderer != wait->renderer) {
+		dmabuf_wait_fail(wait);
+	} else if (ready == 1) {
+		struct wlr_surface *surface = wait->surface;
+		uint32_t seq = wait->seq;
+		// Remove all callbacks before unlocking, which can synchronously emit
+		// commit/damage callbacks and destroy the renderer or surface.
+		dmabuf_wait_destroy(wait);
+		wlr_surface_unlock_cached(surface, seq);
+	} else if (!dmabuf_wait_arm(wait, ready)) {
+		dmabuf_wait_fail(wait);
+	}
+}
+
+static int dmabuf_wait_fd(int fd, uint32_t mask, void *data) {
+	(void)fd;
+	dmabuf_wait_check(data, mask & (WL_EVENT_ERROR | WL_EVENT_HANGUP));
+	return 0;
+}
+
+static int dmabuf_wait_timer(void *data) {
+	dmabuf_wait_check(data, false);
+	return 0;
+}
+
+bool pixman_dmabuf_lock_surface(struct wlr_surface *surface) {
+	struct wlr_renderer *renderer = surface->compositor->renderer;
+	struct wlr_buffer *buffer = surface->pending.buffer;
+	if (renderer == NULL || !wlr_renderer_is_pixman(renderer) ||
+			!(surface->pending.committed & WLR_SURFACE_STATE_BUFFER) ||
+			buffer == NULL || buffer->impl->begin_data_ptr_access != NULL) {
+		return true;
+	}
+	struct wlr_dmabuf_attributes a;
+	if (!wlr_buffer_get_dmabuf(buffer, &a) || a.n_planes != 1 || a.fd[0] < 0) {
+		return false;
+	}
+	int ready = dmabuf_read_ready(a.fd[0]);
+	if (ready == 1 || ready == -1) {
+		return ready == 1;
+	}
+	// Bound waiter descriptors per surface, including clients that submit new
+	// commits while an earlier producer remains busy. Never drop their ordering.
+	size_t count = 0;
+	struct wl_listener *listener;
+	wl_list_for_each(listener, &surface->events.destroy.listener_list, link) {
+		count += listener->notify == dmabuf_wait_surface_destroy;
+	}
+	if (count >= 64) {
+		return false;
+	}
+	struct pixman_dmabuf_wait *wait = calloc(1, sizeof(*wait));
+	if (wait == NULL) {
+		return false;
+	}
+	wait->fd = fcntl(a.fd[0], F_DUPFD_CLOEXEC, 0);
+	if (wait->fd < 0) {
+		free(wait);
+		return false;
+	}
+	wait->surface = surface;
+	wait->renderer = renderer;
+	wait->loop = wl_display_get_event_loop(wl_client_get_display(
+		wl_resource_get_client(surface->resource)));
+	wait->surface_destroy.notify = dmabuf_wait_surface_destroy;
+	wait->renderer_destroy.notify = dmabuf_wait_renderer_destroy;
+	wait->renderer_lost.notify = dmabuf_wait_renderer_lost;
+	wl_signal_add(&surface->events.destroy, &wait->surface_destroy);
+	wl_signal_add(&renderer->events.destroy, &wait->renderer_destroy);
+	wl_signal_add(&renderer->events.lost, &wait->renderer_lost);
+	if (!dmabuf_wait_arm(wait, ready)) {
+		dmabuf_wait_destroy(wait);
+		return false;
+	}
+	// The pending/cached state owns the buffer lock. Our duplicate keeps the fd
+	// valid even if the client destroys wl_buffer while this commit is queued.
+	wait->seq = wlr_surface_lock_pending(surface);
+	return true;
+}
--- a/render/pixman/meson.build
+++ b/render/pixman/meson.build
@@ -3,6 +3,8 @@
 wlr_deps += pixman
 
 wlr_files += files(
+	'dmabuf.c',
