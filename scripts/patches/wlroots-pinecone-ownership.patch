+	uint32_t drm_format;
+	size_t stride;
+	if (!buffer->impl->begin_data_ptr_access(buffer, flags, &data, &drm_format, &stride)) {
+		return false;
+	}
+	pixman_format_code_t format = get_pixman_format_from_drm(drm_format);
+	pixman_image_t *next = NULL;
+	if (format && buffer->height > 0 && stride <= INT_MAX &&
+			stride <= SIZE_MAX / (size_t)buffer->height) {
+		next = pixman_image_create_bits_no_clear(format, buffer->width,
+			buffer->height, data, stride);
+	}
