+	if (!*lease) {
+		if (next) pixman_image_unref(next);
+		buffer->impl->end_data_ptr_access(buffer);
+		// Escaped pointers and failed registration stay on the fenced CPU path.
+		return begin_pixman_data_ptr_access(buffer, image, flags);
+	}
+	if (*image) pixman_image_unref(*image);
+	*image = next;
+	buffer->accessing_data_ptr = true;
+	return true;
