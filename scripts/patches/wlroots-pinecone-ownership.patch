+		wlr_buffer_lock(buffer);
+		*lease = pinecone_pixman_buffer_register(data, stride * buffer->height,
+			buffer, release_pinecone_buffer);
+		if (!*lease) {
+			wlr_buffer_unlock(buffer);
+		} else if (!pinecone_pixman_image_attach_buffer(next, *lease)) {
+			pinecone_pixman_buffer_unregister(*lease);
+			*lease = NULL;
+		}
