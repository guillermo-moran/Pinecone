   gtk_window_present (GTK_WINDOW (self->window));
+  pinecone_release_prewarm (self);
 }
 
 static void
+cc_application_shutdown (GApplication *application)
+{
+  CcApplication *self = CC_APPLICATION (application);
+
+  pinecone_cancel_prewarm (self, PINECONE_PREWARM_STOPPED);
+  pinecone_release_prewarm (self);
+  if (self->window)
+    gtk_widget_set_opacity (GTK_WIDGET (self->window), 1.0);
+
+  G_APPLICATION_CLASS (cc_application_parent_class)->shutdown (application);
+}
