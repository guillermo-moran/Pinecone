+static void
+cc_application_ensure_window (CcApplication *self)
+{
+  if (self->window)
+    return;
+
+  self->window = cc_window_new (GTK_APPLICATION (self), self->model);
+  g_object_add_weak_pointer (G_OBJECT (self->window),
+                             (gpointer *) &self->window);
+}
+
+static void
+pinecone_write_prewarm_ready_file (void)
+{
+  const char *path = g_getenv ("PINECONE_SETTINGS_PREWARM_READY_FILE");
+  g_autoptr(GError) error = NULL;
+
+  if (path == NULL || *path == '\0')
+    return;
+
+  if (!g_file_set_contents (path, "", 0, &error))
+    g_warning ("Failed to publish Pinecone Settings prewarm state: %s",
+               error->message);
+}
+
+static void
+pinecone_release_prewarm (CcApplication *self)
+{
+  if (self->pinecone_prewarm_held)
+    {
+      self->pinecone_prewarm_held = FALSE;
+      g_application_release (G_APPLICATION (self));
+    }
+}
+
+static void
+pinecone_cancel_prewarm (CcApplication       *self,
+                         PineconePrewarmState state)
+{
+  self->pinecone_prewarm_state = state;
+  /* Clear the ID before removal invokes the source's unref destroy notify. */
+  g_clear_handle_id (&self->pinecone_prewarm_source_id, g_source_remove);
+}
+
+static gboolean
+pinecone_finish_prewarm (gpointer user_data)
+{
+  CcApplication *self = CC_APPLICATION (user_data);
+
+  self->pinecone_prewarm_source_id = 0;
+  if (self->pinecone_prewarm_state != PINECONE_PREWARM_PENDING)
+    return G_SOURCE_REMOVE;
+
+  if (self->window == NULL)
+    {
+      self->pinecone_prewarm_state = PINECONE_PREWARM_STOPPED;
+      pinecone_release_prewarm (self);
+      return G_SOURCE_REMOVE;
+    }
+
+  self->pinecone_prewarm_state = PINECONE_PREWARM_READY;
+  gtk_widget_set_visible (GTK_WIDGET (self->window), FALSE);
+  gtk_widget_set_opacity (GTK_WIDGET (self->window), 1.0);
+  pinecone_write_prewarm_ready_file ();
+  g_message ("Pinecone Settings prewarm ready");
+
+  return G_SOURCE_REMOVE;
 }
 
+static void
+pinecone_start_prewarm (CcApplication *self)
+{
+  /* Only an explicit option starts prewarm, and only once per process.
+   * In particular, a late prewarm request must never hide an active window. */
+  if (self->pinecone_prewarm_state != PINECONE_PREWARM_OFF)
+    return;
+
+  self->pinecone_prewarm_state = PINECONE_PREWARM_PENDING;
+  g_application_hold (G_APPLICATION (self));
+  self->pinecone_prewarm_held = TRUE;
+  cc_application_ensure_window (self);
+  if (self->pinecone_prewarm_state != PINECONE_PREWARM_PENDING)
+    return;
+
+  /* Do not synthesize an activation: every activation belongs to the user. */
+  gtk_widget_set_opacity (GTK_WIDGET (self->window), 0.0);
+  gtk_window_present (GTK_WINDOW (self->window));
+
+  /* Presentation may dispatch a real activation through a nested main loop. */
+  if (self->pinecone_prewarm_state == PINECONE_PREWARM_PENDING)
+    self->pinecone_prewarm_source_id =
+      g_timeout_add_full (G_PRIORITY_LOW,
+                          34,
+                          pinecone_finish_prewarm,
+                          g_object_ref (self),
+                          g_object_unref);
+}
