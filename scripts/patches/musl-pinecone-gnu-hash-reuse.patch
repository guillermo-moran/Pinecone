-static int startup_sym_index_add_symbol(struct dso *p, size_t index)
+static int startup_sym_index_gnu_hash(uint32_t chain_hash, uint32_t bucket,
+	uint32_t bucket_count, uint32_t *hash)
+{
+	/* GNU chains replace bit zero with an end marker. For more than one
+	 * bucket, adjacent hashes cannot belong to the same bucket, so its
+	 * index recovers that bit without reading the symbol name. */
+	if (bucket_count <= 1 || bucket >= bucket_count)
+		return 0;
+	uint32_t even = chain_hash & ~1U;
+	if (even % bucket_count == bucket) {
+		*hash = even;
+		return 1;
+	}
+	if ((even | 1U) % bucket_count == bucket) {
+		*hash = even | 1U;
+		return 1;
+	}
+	/* Inconsistent tables still use the existing name-based lookup. */
+	return 0;
+}
