+static GList *
+load_initial_app_manifest (gboolean *loaded)
+{
+  const char *path = g_getenv ("PINECONE_PHOSH_APP_MANIFEST");
+  g_autofree char *contents = NULL;
+  g_auto (GStrv) lines = NULL;
+  g_autoptr (GError) err = NULL;
+  GList *apps = NULL;
+
+  *loaded = FALSE;
+  if (path == NULL || *path == '\0')
+    return NULL;
+
+  if (!g_file_get_contents (path, &contents, NULL, &err)) {
+    g_warning ("Failed to load Pinecone app manifest '%s': %s", path, err->message);
+    return NULL;
+  }
+
+  lines = g_strsplit (contents, "\n", -1);
+  for (int i = 0; lines[i] != NULL; i++) {
+    g_autoptr (GDesktopAppInfo) info = NULL;
+    char *desktop_id = g_strstrip (lines[i]);
+
+    if (*desktop_id == '\0' || *desktop_id == '#')
+      continue;
+
+    info = g_desktop_app_info_new (desktop_id);
+    if (info == NULL) {
+      g_warning ("Pinecone app manifest entry '%s' is unavailable", desktop_id);
+      continue;
+    }
+    apps = g_list_prepend (apps, g_steal_pointer (&info));
+  }
+
+  *loaded = TRUE;
+  g_message ("Pinecone app manifest loaded with %u entries", g_list_length (apps));
+  return g_list_reverse (apps);
+}
