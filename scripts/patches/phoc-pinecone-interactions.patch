+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+#include <glib.h>
+typedef struct {
+  uint64_t epoch, sequence;
+  gint64 start;
+  uint32_t time_msec;
+  int32_t touch_id;
+  const char *phase;
+  gint64 cpu_start;
+} PineconeTraceTouch;
+bool pinecone_trace_enabled(void);
+PineconeTraceTouch pinecone_trace_touch(uint32_t time_msec, int32_t touch_id, const char *phase);
+void pinecone_trace_touch_end(PineconeTraceTouch *touch);
+G_DEFINE_AUTO_CLEANUP_CLEAR_FUNC(PineconeTraceTouch, pinecone_trace_touch_end)
+void pinecone_trace_begin(void *output, uint32_t sequence);
+void pinecone_trace_app(void *output, const char *app_id);
+void pinecone_trace_submit(void *output);
+void pinecone_trace_commit(void *output);
+void pinecone_trace_present(void *output, uint32_t sequence, int presented);
+void pinecone_trace_abort(void *output);
+void pinecone_trace_destroy(void *output);
--- a/src/pinecone-trace.c
+++ b/src/pinecone-trace.c
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pinecone-trace.h"
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <time.h>
+
+/* Main-loop only. Input identity is local to Phoc, not the host wire identity.
+ * A recent input is diagnostic context, NEVER proof that it caused a frame.
+ * App presentation remains scheduling control, independent of trace budgets. */
+struct trace_frame {
+  void *output;
+  uint32_t sequence;
+  uint64_t epoch, id;
+  PineconeTraceTouch input;
+  gint64 render, submit, commit;
+  gint64 render_cpu, submit_cpu, commit_cpu;
+  unsigned count;
+  char apps[8][96];
+};
+static struct trace_frame frames[32];
+static struct trace_frame *active;
+static PineconeTraceTouch last_input;
+static uint64_t epoch, input_sequence, frame_id;
+static int trace_fd = -1;
+static int control_fd = -1;
+static gsize initialized;
+static unsigned records;
+static gint64 last_control;
+static void *last_control_output;
+static char last_control_apps[8][96];
+
+static gint64 thread_cpu_us(void) {
+  struct timespec now;
+  if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now) != 0) return -1;
+  return (gint64)now.tv_sec * G_USEC_PER_SEC + now.tv_nsec / 1000;
+}
+
+bool pinecone_trace_enabled(void) {
+  if (g_once_init_enter(&initialized)) {
+    control_fd = open("/dev/ttyAMA0", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    epoch = MAX((uint64_t)g_get_monotonic_time(), 1);
+    if (g_strcmp0(g_getenv("PINECONE_INTERACTION_TRACE"), "1") == 0)
+      trace_fd = open("/dev/ttyAMA0", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    g_once_init_leave(&initialized, 1);
+  }
+  return trace_fd >= 0 && records < 8192;
+}
+
+static void emit(const char *line, size_t length) {
+  ++records;
+  /* No retry/backpressure. RS lets the decoder recover after a short write. */
+  (void)write(trace_fd, line, length);
+}
+
+static void next_epoch(void) {
+  if (epoch == UINT64_MAX) { records = 8192; return; }
+  ++epoch;
+  input_sequence = frame_id = 0;
+  last_input = (PineconeTraceTouch){0};
+}
+
+PineconeTraceTouch pinecone_trace_touch(uint32_t time_msec, int32_t touch_id, const char *phase) {
+  if (!pinecone_trace_enabled()) return (PineconeTraceTouch){0};
+  if (input_sequence == UINT64_MAX) next_epoch();
+  if (!pinecone_trace_enabled()) return (PineconeTraceTouch){0};
+  return (PineconeTraceTouch){epoch, ++input_sequence, g_get_monotonic_time(), time_msec, touch_id, phase, thread_cpu_us()};
+}
+
+void pinecone_trace_touch_end(PineconeTraceTouch *touch) {
+  if (!touch->sequence || !pinecone_trace_enabled()) return;
+  gint64 end = g_get_monotonic_time();
+  gint64 cpu_end = thread_cpu_us();
+  char line[512];
+  int n = snprintf(line, sizeof(line),
+    "\036PINECONE_TRACE {\"version\":2,\"event\":\"touch\",\"epoch\":%" G_GUINT64_FORMAT
+    ",\"inputSequence\":%" G_GUINT64_FORMAT ",\"guestUs\":%" G_GINT64_FORMAT
+    ",\"handlerEndUs\":%" G_GINT64_FORMAT ",\"eventTimeMsec\":%u,\"touchID\":%d,"
+    "\"phase\":\"%s\",\"association\":\"none\"",
+    touch->epoch, touch->sequence, touch->start, end, touch->time_msec, touch->touch_id, touch->phase);
+  if (touch->cpu_start >= 0 && cpu_end >= touch->cpu_start && n > 0 && (size_t)n < sizeof(line))
+    n += snprintf(line + n, sizeof(line) - (size_t)n, ",\"handlerCPUUs\":%" G_GINT64_FORMAT,
+                  cpu_end - touch->cpu_start);
+  if (n > 0 && (size_t)n < sizeof(line))
+    n += snprintf(line + n, sizeof(line) - (size_t)n, "}\n");
+  if (n > 0 && (size_t)n < sizeof(line)) emit(line, (size_t)n);
+  last_input = *touch;
+}
+
+static void retire(struct trace_frame *frame, const char *reason) {
+  if (pinecone_trace_enabled()) {
+    char line[384];
+    int n = snprintf(line, sizeof(line),
+      "\036PINECONE_TRACE {\"version\":2,\"event\":\"dropped\",\"epoch\":%" G_GUINT64_FORMAT
+      ",\"frameID\":%" G_GUINT64_FORMAT ",\"outputID\":%" G_GUINT64_FORMAT
+      ",\"sequence\":%u,\"guestUs\":%" G_GINT64_FORMAT ",\"reason\":\"%s\"}\n",
+      frame->epoch, frame->id, (uint64_t)(uintptr_t)frame->output,
+      frame->sequence, g_get_monotonic_time(), reason);
+    if (n > 0 && (size_t)n < sizeof(line)) emit(line, (size_t)n);
+  }
+  if (active == frame) active = NULL;
+  memset(frame, 0, sizeof(*frame));
+}
+
+void pinecone_trace_begin(void *output, uint32_t sequence) {
+  (void)pinecone_trace_enabled();
+  gint64 now = g_get_monotonic_time();
+  struct trace_frame *free_frame = NULL, *oldest = &frames[0];
+  for (unsigned i = 0; i < G_N_ELEMENTS(frames); ++i) {
+    struct trace_frame *f = &frames[i];
+    if (f->output == output && f->sequence == sequence)
+      retire(f, "sequenceReused");
+    if (!f->output) free_frame = f;
+    if (f->render < oldest->render) oldest = f;
+  }
+  if (!free_frame) { retire(oldest, "capacityEvicted"); free_frame = oldest; }
+  if (frame_id == UINT64_MAX) next_epoch();
+  active = free_frame;
+  *active = (struct trace_frame){ .output = output, .sequence = sequence,
+    .epoch = epoch, .id = ++frame_id, .render = now,
+    .render_cpu = pinecone_trace_enabled() ? thread_cpu_us() : -1,
+    .submit_cpu = -1, .commit_cpu = -1 };
+  if (last_input.epoch == epoch && last_input.sequence && now >= last_input.start &&
+      now - last_input.start <= 2 * G_USEC_PER_SEC)
+    active->input = last_input;
+  last_input = (PineconeTraceTouch){0};
+}
+
+void pinecone_trace_app(void *output, const char *app_id) {
+  if (!active || active->output != output || !app_id || !*app_id) return;
+  size_t length = strlen(app_id);
+  if (length >= sizeof(active->apps[0])) return;
+  for (size_t i = 0; i < length; ++i)
+    if (!g_ascii_isalnum(app_id[i]) && !strchr("._-", app_id[i])) return;
+  for (unsigned i = 0; i < active->count; ++i)
+    if (strcmp(active->apps[i], app_id) == 0) return;
+  if (active->count < G_N_ELEMENTS(active->apps))
+    g_strlcpy(active->apps[active->count++], app_id, sizeof(active->apps[0]));
+}
+
+void pinecone_trace_submit(void *output) {
+  if (pinecone_trace_enabled() && active && active->output == output) {
+    active->submit = g_get_monotonic_time();
+    active->submit_cpu = thread_cpu_us();
+  }
+}
+
+void pinecone_trace_commit(void *output) {
+  if (pinecone_trace_enabled() && active && active->output == output) {
+    active->commit = g_get_monotonic_time();
+    active->commit_cpu = thread_cpu_us();
+  }
+}
+
+void pinecone_trace_abort(void *output) {
+  if (active && active->output == output) retire(active, "aborted");
+}
+
+void pinecone_trace_destroy(void *output) {
+  for (unsigned i = 0; i < G_N_ELEMENTS(frames); ++i)
+    if (frames[i].output == output) retire(&frames[i], "outputDestroyed");
+  if (last_control_output == output) last_control_output = NULL;
+}
+
+void pinecone_trace_present(void *output, uint32_t sequence, int presented) {
+  struct trace_frame *frame = NULL;
+  for (unsigned i = 0; i < G_N_ELEMENTS(frames); ++i)
+    if (frames[i].output == output && frames[i].sequence == sequence) { frame = &frames[i]; break; }
+  if (!frame) return;
+  gint64 now = g_get_monotonic_time();
+  if (!presented) { retire(frame, "notPresented"); return; }
+  if (control_fd >= 0 && frame->count &&
+      (last_control_output != output || now - last_control >= G_USEC_PER_SEC ||
+       memcmp(last_control_apps, frame->apps, sizeof(frame->apps)) != 0)) {
+    bool complete = true;
+    for (unsigned i = 0; i < frame->count; ++i) {
+      char line[128];
+      int n = snprintf(line, sizeof(line), "\036PINECONE_APP_PRESENTED %s\n", frame->apps[i]);
+      if (n > 0 && (size_t)n < sizeof(line))
+        complete &= write(control_fd, line, (size_t)n) == n;
+    }
+    if (complete) {
+      last_control = now;
+      last_control_output = output;
+      memcpy(last_control_apps, frame->apps, sizeof(frame->apps));
+    }
+  }
+  // Expiry affects diagnostics only, never application scheduling control.
+  if (now < frame->render || now - frame->render > 10 * G_USEC_PER_SEC) {
+    retire(frame, "expired"); return;
+  }
+  if (pinecone_trace_enabled() && frame->render && frame->submit && frame->commit) {
+    char line[1536];
+    int n = snprintf(line, sizeof(line),
+      "\036PINECONE_TRACE {\"version\":2,\"event\":\"present\",\"epoch\":%" G_GUINT64_FORMAT
+      ",\"frameID\":%" G_GUINT64_FORMAT ",\"outputID\":%" G_GUINT64_FORMAT
+      ",\"guestUs\":%" G_GINT64_FORMAT ",\"renderUs\":%" G_GINT64_FORMAT
+      ",\"submitUs\":%" G_GINT64_FORMAT ",\"commitUs\":%" G_GINT64_FORMAT
+      ",\"sequence\":%u,", frame->epoch, frame->id, (uint64_t)(uintptr_t)output,
+      now, frame->render, frame->submit, frame->commit, sequence);
+    if (frame->render_cpu >= 0 && frame->submit_cpu >= frame->render_cpu &&
+        frame->commit_cpu >= frame->submit_cpu && n > 0 && (size_t)n < sizeof(line))
+      n += snprintf(line + n, sizeof(line) - (size_t)n,
+        "\"renderCPUUs\":%" G_GINT64_FORMAT ",\"submitCPUUs\":%" G_GINT64_FORMAT
+        ",\"commitCPUUs\":%" G_GINT64_FORMAT ",",
+        frame->render_cpu, frame->submit_cpu, frame->commit_cpu);
+    if (frame->input.sequence && n > 0 && (size_t)n < sizeof(line))
+      n += snprintf(line + n, sizeof(line) - (size_t)n,
+        "\"inputSequence\":%" G_GUINT64_FORMAT ",\"inputUs\":%" G_GINT64_FORMAT
+        ",\"association\":\"temporalOnly\",", frame->input.sequence, frame->input.start);
+    if (n > 0 && (size_t)n < sizeof(line))
+      n += snprintf(line + n, sizeof(line) - (size_t)n, "\"apps\":[");
+    for (unsigned i = 0; n > 0 && (size_t)n < sizeof(line) && i < frame->count; ++i)
+      n += snprintf(line + n, sizeof(line) - (size_t)n, "%s\"%s\"", i ? "," : "", frame->apps[i]);
+    if (n > 0 && (size_t)n + 4 < sizeof(line)) {
+      memcpy(line + n, "]}\n", 3);
+      emit(line, (size_t)n + 3);
+    }
+  }
+  if (active == frame) active = NULL;
+  memset(frame, 0, sizeof(*frame));
+}
