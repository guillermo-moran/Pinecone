+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+bool pinecone_trace_enabled(void);
+void pinecone_trace_touch(void);
+void pinecone_trace_begin(void *output, uint32_t sequence);
+void pinecone_trace_app(void *output, const char *app_id);
+void pinecone_trace_submit(void *output);
+void pinecone_trace_commit(void *output);
+void pinecone_trace_present(void *output, uint32_t sequence, int presented);
--- a/src/pinecone-trace.c
+++ b/src/pinecone-trace.c
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pinecone-trace.h"
+#include <glib.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Called only from Phoc's main loop. Diagnostics are bounded and opt-in.
+ * App presentation is scheduling control, independent of the trace budget.
+ * A full ring loses a sample, never attaches an old app to a new frame. */
+struct trace_frame {
+  void *output;
+  uint32_t sequence;
+  gint64 input, render, submit, commit;
+  unsigned count;
+  char apps[8][96];
+};
+static struct trace_frame frames[32];
+static struct trace_frame *active;
+static gint64 last_input;
+static int trace_fd = -1;
+static int control_fd = -1;
+static gsize initialized;
+static unsigned records;
+static gint64 last_control;
+static void *last_control_output;
+static char last_control_apps[8][96];
+
+bool pinecone_trace_enabled(void) {
+  if (g_once_init_enter(&initialized)) {
+    control_fd = open("/dev/ttyAMA0", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (g_strcmp0(g_getenv("PINECONE_INTERACTION_TRACE"), "1") == 0)
+      trace_fd = open("/dev/ttyAMA0", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    g_once_init_leave(&initialized, 1);
+  }
+  return trace_fd >= 0 && records < 8192;
+}
+
+static void emit(const char *line, size_t length) {
+  ++records;
+  /* Partial writes are deliberately not retried; the receiver rejects them. */
+  (void)write(trace_fd, line, length);
+}
+
+void pinecone_trace_touch(void) {
+  if (!pinecone_trace_enabled()) return;
+  last_input = g_get_monotonic_time();
+  char line[128];
+  int n = snprintf(line, sizeof(line), "PINECONE_TRACE {\"event\":\"touch\",\"guestUs\":%" G_GINT64_FORMAT "}\n", last_input);
+  if (n > 0 && (size_t)n < sizeof(line)) emit(line, (size_t)n);
+}
+
+void pinecone_trace_begin(void *output, uint32_t sequence) {
+  (void)pinecone_trace_enabled();
+  active = &frames[sequence % G_N_ELEMENTS(frames)];
+  *active = (struct trace_frame){ .output = output, .sequence = sequence,
+    .input = last_input, .render = g_get_monotonic_time() };
+  last_input = 0;
+}
+
+void pinecone_trace_app(void *output, const char *app_id) {
+  if (!active || active->output != output || !app_id || !*app_id) return;
+  size_t length = strlen(app_id);
+  if (length >= sizeof(active->apps[0])) return;
+  for (size_t i = 0; i < length; ++i)
+    if (!g_ascii_isalnum(app_id[i]) && !strchr("._-", app_id[i])) return;
+  for (unsigned i = 0; i < active->count; ++i)
+    if (strcmp(active->apps[i], app_id) == 0) return;
+  if (active->count < G_N_ELEMENTS(active->apps))
+    g_strlcpy(active->apps[active->count++], app_id, sizeof(active->apps[0]));
+}
+
+void pinecone_trace_submit(void *output) {
+  if (pinecone_trace_enabled() && active && active->output == output) active->submit = g_get_monotonic_time();
+}
+
+void pinecone_trace_commit(void *output) {
+  if (pinecone_trace_enabled() && active && active->output == output) active->commit = g_get_monotonic_time();
+}
+
+void pinecone_trace_present(void *output, uint32_t sequence, int presented) {
+  struct trace_frame *frame = &frames[sequence % G_N_ELEMENTS(frames)];
+  if (frame->output != output || frame->sequence != sequence) return;
+  gint64 now = g_get_monotonic_time();
+  if (presented && control_fd >= 0 && frame->count &&
+      (last_control_output != output || now - last_control >= G_USEC_PER_SEC ||
+       memcmp(last_control_apps, frame->apps, sizeof(frame->apps)) != 0)) {
+    bool complete = true;
+    for (unsigned i = 0; i < frame->count; ++i) {
+      char line[128];
+      int n = snprintf(line, sizeof(line), "\036PINECONE_APP_PRESENTED %s\n", frame->apps[i]);
+      if (n > 0 && (size_t)n < sizeof(line))
+        complete &= write(control_fd, line, (size_t)n) == n;
+    }
+    if (complete) {
+      last_control = now;
+      last_control_output = output;
+      memcpy(last_control_apps, frame->apps, sizeof(frame->apps));
+    }
+  }
+  if (pinecone_trace_enabled() && presented && frame->render && frame->submit && frame->commit) {
+    char line[1536];
+    int n = snprintf(line, sizeof(line),
+      "PINECONE_TRACE {\"event\":\"present\",\"guestUs\":%" G_GINT64_FORMAT
+      ",\"inputUs\":%" G_GINT64_FORMAT ",\"renderUs\":%" G_GINT64_FORMAT
+      ",\"submitUs\":%" G_GINT64_FORMAT ",\"commitUs\":%" G_GINT64_FORMAT
+      ",\"sequence\":%u,\"apps\":[", g_get_monotonic_time(), frame->input,
+      frame->render, frame->submit, frame->commit, sequence);
+    for (unsigned i = 0; n > 0 && (size_t)n < sizeof(line) && i < frame->count; ++i)
+      n += snprintf(line + n, sizeof(line) - (size_t)n, "%s\"%s\"", i ? "," : "", frame->apps[i]);
+    if (n > 0 && (size_t)n + 4 < sizeof(line)) {
+      memcpy(line + n, "]}\n", 3);
+      emit(line, (size_t)n + 3);
+    }
+  }
+  if (active == frame) active = NULL;
+  memset(frame, 0, sizeof(*frame));
+}
