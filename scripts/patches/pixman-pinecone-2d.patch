 #endif
 #include "pixman-private.h"
 
+extern void pinecone_pixman_created_solid (
+    pixman_image_t       *image,
+    const pixman_color_t *color) __attribute__((weak));
+
 static uint32_t
 color_to_uint32 (const pixman_color_t *color)
 {
@@ -61,5 +65,8 @@ pixman_image_create_solid_fill (const pixman_color_t *color)
     img->solid.color_32 = color_to_uint32 (color);
