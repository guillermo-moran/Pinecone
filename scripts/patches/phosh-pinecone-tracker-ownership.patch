-  g_signal_emit (state->tracker, signals[APP_FAILED], 0, state->info, state->startup_id);
-  g_hash_table_remove (state->tracker->apps, state->startup_id);
+  /* This source is returning REMOVE; state teardown must not remove it twice. */
+  state->timeout.id = 0;
+  complete_app_state (state->tracker, state->startup_id, APP_FAILED);
 
   return G_SOURCE_REMOVE;
 }
