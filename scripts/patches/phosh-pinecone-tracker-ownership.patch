 G_DEFINE_TYPE (PhoshAppTracker, phosh_app_tracker, G_TYPE_OBJECT)
 
 
+/* Async replies can already be queued when cancellation retires a launch.
+ * Keep an identity, not a borrowed state pointer or a strong tracker cycle. */
+typedef struct {
+  GWeakRef tracker;
+  char *startup_id;
+  GCancellable *cancel;
+} PhoshAppStateRequest;
+
+
+static PhoshAppStateRequest *
+phosh_app_state_request_new (PhoshAppState *state)
+{
+  PhoshAppStateRequest *request = g_new0 (PhoshAppStateRequest, 1);
+
+  g_weak_ref_init (&request->tracker, state->tracker);
+  request->startup_id = g_strdup (state->startup_id);
+  request->cancel = g_object_ref (state->flatpak.cancel);
+  return request;
+}
+
+
 static void
+phosh_app_state_request_free (PhoshAppStateRequest *request)
+{
+  g_weak_ref_clear (&request->tracker);
+  g_clear_object (&request->cancel);
+  g_free (request->startup_id);
+  g_free (request);
+}
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (PhoshAppStateRequest, phosh_app_state_request_free)
+
+
+static PhoshAppState *
+phosh_app_state_request_lookup (PhoshAppStateRequest *request, PhoshAppTracker *tracker)
+{
+  PhoshAppState *state;
+
+  if (!tracker || g_cancellable_is_cancelled (request->cancel))
+    return NULL;
+
+  state = g_hash_table_lookup (tracker->apps, request->startup_id);
+  /* A new launch may reuse the same startup id. */
+  return state && state->flatpak.cancel == request->cancel ? state : NULL;
+}
+
+
+/* Handlers may retire/recreate the same id or release the last tracker owner. */
+static void
+complete_app_state (PhoshAppTracker *self, const char *startup_id, guint signal)
+{
+  g_autoptr (PhoshAppTracker) tracker = g_object_ref (self);
+  g_autoptr (GDesktopAppInfo) info = NULL;
+  g_autofree char *id = NULL;
+  PhoshAppState *state;
+
+  state = g_hash_table_lookup (tracker->apps, startup_id);
+  if (!state)
+    return;
+
+  info = g_object_ref (state->info);
+  id = g_strdup (state->startup_id);
+  g_hash_table_remove (tracker->apps, id);
+  g_signal_emit (tracker, signals[signal], 0, info, id);
+}
+
+
+static void
 check_flatpak_state (PhoshAppState *state)
 {
   g_autoptr (GVariant) value = NULL;
@@ -206,8 +272,9 @@
              g_app_info_get_name (G_APP_INFO (state->info)),
