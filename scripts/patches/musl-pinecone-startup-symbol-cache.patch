+static void startup_sym_index_prepare(void)
+{
+	size_t candidate_count = startup_sym_index_candidate_count();
+	STARTUP_STAT(startup_stats.candidates = candidate_count);
+	if (!candidate_count)
+		return;
+
+	size_t slot_count = STARTUP_SYM_INDEX_MIN_SLOT_COUNT;
+	while (slot_count < STARTUP_SYM_INDEX_MAX_SLOT_COUNT &&
+	    candidate_count > slot_count / 2)
+		slot_count *= 2;
+	if (slot_count > (size_t)-1 / sizeof(struct startup_sym_index_entry))
+		return;
+
+	startup_sym_index_bytes =
+		slot_count * sizeof(struct startup_sym_index_entry);
+	startup_sym_index = dl_mmap(startup_sym_index_bytes);
+	if (!startup_sym_index) {
+		startup_sym_index_bytes = 0;
+		return;
+	}
+	startup_sym_index_slot_count = slot_count;
+
+	int complete = 1;
+	for (struct dso *p = head; p && complete; p = p->syms_next) {
+		if (p->ghashtab) {
+			size_t first = p->ghashtab[1];
+			size_t end = count_syms(p);
+			for (size_t i = first; i < end; i++) {
+				if (!startup_sym_index_add_symbol(p, i)) {
+					complete = 0;
+					break;
+				}
+			}
+		} else if (p->hashtab) {
+			size_t bucket_count = p->hashtab[0];
+			size_t symbol_count = p->hashtab[1];
+			Elf_Symndx *buckets = p->hashtab + 2;
+			Elf_Symndx *chains = buckets + bucket_count;
+			for (size_t bucket = 0; bucket < bucket_count && complete;
+			    bucket++) {
+				size_t steps = 0;
+				for (size_t i = buckets[bucket]; i && i < symbol_count &&
+				    steps++ < symbol_count; i = chains[i]) {
+					if (!startup_sym_index_add_symbol(p, i)) {
+						complete = 0;
+						break;
+					}
+				}
+			}
+		}
+	}
