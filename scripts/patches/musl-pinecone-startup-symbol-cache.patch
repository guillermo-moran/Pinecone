+static size_t startup_sym_index_candidate_count(void)
+{
+	size_t count = 0;
+	for (struct dso *p = head; p; p = p->syms_next) {
+		size_t dso_count = 0;
+		if (p->ghashtab) {
+			size_t first = p->ghashtab[1];
+			size_t end = count_syms(p);
+			if (end > first)
+				dso_count = end - first;
+		} else if (p->hashtab) {
+			dso_count = p->hashtab[1];
+		}
+		if (dso_count > STARTUP_SYM_INDEX_MAX_SLOT_COUNT - count)
+			return STARTUP_SYM_INDEX_MAX_SLOT_COUNT;
+		count += dso_count;
+	}
+	return count;
+}
