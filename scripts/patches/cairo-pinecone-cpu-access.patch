+extern void pinecone_pixman_begin_cpu_access_flags (uint32_t)
+    __attribute__((weak, visibility("default")));
+extern void pinecone_pixman_end_cpu_access (void)
+    __attribute__((weak, visibility("default")));
+extern uint32_t *pinecone_pixman_get_data_escaping (pixman_image_t *)
+    __attribute__((weak, visibility("default")));
+
+static inline int
+_cairo_image_access_begin (uint32_t flags)
+{
+    if (!pinecone_pixman_begin_cpu_access_flags ||
+        !pinecone_pixman_end_cpu_access ||
+        !pinecone_pixman_get_data_escaping)
+        return 0;
+    pinecone_pixman_begin_cpu_access_flags (flags);
+    return 1;
+}
+
+static inline void
+_cairo_image_access_end (int *active)
+{
+    if (*active)
+        pinecone_pixman_end_cpu_access ();
+}
+
+/* GCC/Clang cleanup covers every early return, including compositor errors.
+ * The scope does not acquire pixels until a data accessor is actually used. */
+#define CAIRO_IMAGE_ACCESS(flags) \
+    int _cairo_access __attribute__((cleanup(_cairo_image_access_end))) = \
+        _cairo_image_access_begin (flags)
