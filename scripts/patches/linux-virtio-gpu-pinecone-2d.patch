+
+static void pinecone_2d_translate_slot(struct virtio_gpu_submit *submit,
+				       __le32 *slot)
+{
+	u32 index = le32_to_cpu(*slot);
+	struct virtio_gpu_object *object;
+
+	if (!index)
+		return;
+	object = gem_to_virtio_gpu_obj(submit->buflist->objs[index - 1U]);
+	*slot = cpu_to_le32(object->hw_res_handle);
 }
 
 static void virtio_gpu_submit(struct virtio_gpu_submit *submit)
 {
+	if (!submit->vgdev->has_virgl_3d) {
+		struct pinecone_2d_payload *payload = submit->buf;
+		struct pinecone_2d_batch_header *header = submit->buf;
+		struct virtio_gpu_object *source;
+		struct virtio_gpu_object *mask;
+		struct virtio_gpu_object *destination;
+		u32 flags;
+		u16 operation;
+		u32 index = 0;
+
+		if (le16_to_cpu(header->version) == PINECONE_2D_BATCH_VERSION) {
+			u32 command_count = le16_to_cpu(header->command_count);
+			u32 command_index;
+
+			payload = (void *)((u8 *)submit->buf +
+				PINECONE_2D_BATCH_HEADER_SIZE);
+			for (command_index = 0; command_index < command_count;
+			     command_index++) {
+				pinecone_2d_translate_slot(
+					submit, &payload[command_index].source_resource_id);
+				pinecone_2d_translate_slot(
+					submit, &payload[command_index].mask_resource_id);
+				pinecone_2d_translate_slot(
+					submit, &payload[command_index].destination_resource_id);
+			}
+			virtio_gpu_cmd_submit(
+				submit->vgdev, submit->buf, submit->exbuf->size, 0,
+				submit->buflist, submit->out_fence);
+			virtio_gpu_notify(submit->vgdev);
+			return;
+		}
+
+		flags = le32_to_cpu(payload->flags);
+		operation = le16_to_cpu(payload->operation);
+
+		if ((le16_to_cpu(payload->version) == PINECONE_2D_VERSION &&
+		     (operation == 1 || operation == 2)) ||
+		    (le16_to_cpu(payload->version) ==
+		     PINECONE_2D_EXACT_COMPOSITE_VERSION &&
+		     operation != 0 && operation != 2 &&
+		     !(flags & PINECONE_2D_SOURCE_IS_SOLID))) {
+			source = gem_to_virtio_gpu_obj(submit->buflist->objs[index++]);
+			payload->source_resource_id =
+				cpu_to_le32(source->hw_res_handle);
+		} else {
+			payload->source_resource_id = 0;
+		}
+		if ((flags & PINECONE_2D_HAS_MASK) &&
+		    !(flags & PINECONE_2D_MASK_IS_SOLID)) {
+			mask = gem_to_virtio_gpu_obj(submit->buflist->objs[index++]);
+			payload->mask_resource_id =
+				cpu_to_le32(mask->hw_res_handle);
+		} else {
+			payload->mask_resource_id = 0;
+		}
+		destination = gem_to_virtio_gpu_obj(submit->buflist->objs[index]);
+		payload->destination_resource_id =
+			cpu_to_le32(destination->hw_res_handle);
+		virtio_gpu_cmd_submit(submit->vgdev, submit->buf,
+				      PINECONE_2D_PAYLOAD_SIZE, 0,
+				      submit->buflist, submit->out_fence);
+		virtio_gpu_notify(submit->vgdev);
+		return;
+	}
+
 	virtio_gpu_cmd_submit(submit->vgdev, submit->buf, submit->exbuf->size,
 			      submit->vfpriv->ctx_id, submit->buflist,
 			      submit->out_fence);
@@ -482,9 +736,13 @@
