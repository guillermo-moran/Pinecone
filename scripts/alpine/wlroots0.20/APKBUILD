2eb70aa7d57fea7e7e36917d73f2a1a9b304c28a331cac32756cb61f8926c51e989887811037cfb76e29452f0dcbe61fa4980c39553c7433a6f6fc3a8b69c7d7  e8c983808d8b98a71f991c16c24367494386958b.patch
2d1cd36e63a596e18b25554d032e792459b8314c6743486e0e68d998ac1674467b7b4ee448c6a8b70f8bb2994c60cdaee4c94d61e25ba43eb26d2664abceca99  wlroots-pinecone-0.20.2.patch
"
