# Pinecone build of Alpine's wlroots0.20 package.
maintainer="Pinecone Project <internal@pinecone.invalid>"
pkgname=wlroots0.20
pkgver=0.20.2
_pkgver=${pkgver/_/-}
pkgrel=3
pkgdesc="Modular Wayland compositor library with Pinecone render-pass integration"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license="MIT"
arch="aarch64"
makedepends="
	eudev-dev
	glslang-dev
	hwdata-dev
	libcap-dev
	libdisplay-info-dev
	libinput-dev
	libseat-dev
	libliftoff-dev
	libxcb-dev
	libxkbcommon-dev
	lcms2-dev
	mesa-dev
	meson
	ninja
	pixman-dev
	vulkan-loader-dev
	wayland-dev
	wayland-protocols
	xcb-util-image-dev
	xcb-util-renderutil-dev
	xcb-util-wm-dev
	xkeyboard-config-dev
	xwayland-dev
	"
depends_dev="$pkgname=$pkgver-r$pkgrel"
subpackages="$pkgname-dbg $pkgname-static $pkgname-dev"
source="https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/$_pkgver/wlroots-$_pkgver.tar.gz
	e8c983808d8b98a71f991c16c24367494386958b.patch
	wlroots-pinecone-0.20.2.patch
	"
builddir="$srcdir/wlroots-$_pkgver"
options="!check"
provides="wlroots=$pkgver-r$pkgrel"
replaces="wlroots"

dev() {
	default_dev
	provides="wlroots-dev=$pkgver-r$pkgrel"
	replaces="wlroots-dev"
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dexamples=false \
		-Dcolor-management=enabled \
		-Ddefault_library=both \
		. build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

