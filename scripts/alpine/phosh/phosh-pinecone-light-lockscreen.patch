diff -ruN -x subprojects a/tests/test-pinecone-lockscreen-policy.c b/tests/test-pinecone-lockscreen-policy.c
--- a/tests/test-pinecone-lockscreen-policy.c	1969-12-31 18:00:00
+++ b/tests/test-pinecone-lockscreen-policy.c	2026-10-27 22:29:13
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pinecone-lockscreen-policy.h"
+#include <handy.h>
+
+static void
+page_changed (HdyCarousel *carousel, guint index, guint *changes)
+{
+  (*changes)++;
+}
+
+static void
+test_static_transition (void)
+{
+  for (guint pin = 0; pin < 2; pin++) {
+    GtkWidget *window = gtk_window_new (GTK_WINDOW_TOPLEVEL);
+    GtkWidget *carousel = hdy_carousel_new ();
+    GtkWidget *info = gtk_label_new ("Clock");
+    GtkWidget *keypad = gtk_label_new ("PIN");
+    guint changes = 0;
+    gtk_container_add (GTK_CONTAINER (window), carousel);
+    gtk_container_add (GTK_CONTAINER (carousel), info);
+    gtk_container_add (GTK_CONTAINER (carousel), keypad);
+    hdy_carousel_set_interactive (HDY_CAROUSEL (carousel), FALSE);
+    hdy_carousel_set_animation_duration (HDY_CAROUSEL (carousel), 0);
+    gtk_widget_show_all (window);
+    gtk_widget_set_visible (keypad, pin);
+    while (g_main_context_iteration (NULL, FALSE));
+    g_signal_connect (carousel, "page-changed", G_CALLBACK (page_changed), &changes);
+    hdy_carousel_scroll_to (HDY_CAROUSEL (carousel), keypad);
+    while (g_main_context_iteration (NULL, FALSE));
+    g_assert_cmpfloat_with_epsilon (hdy_carousel_get_position (HDY_CAROUSEL (carousel)), 1.0, 0.0001);
+    g_assert_cmpuint (changes, ==, 1);
+    gtk_widget_destroy (window);
+  }
+}
+
+static void
+count_click (GtkButton *button, guint *clicks)
+{
+  (*clicks)++;
+}
+
+static void
+test_button (void)
+{
+  GtkWidget *button = pinecone_lockscreen_create_unlock_button ();
+  guint clicks = 0;
+  int width, height;
+  g_object_ref_sink (button);
+  g_signal_connect (button, "clicked", G_CALLBACK (count_click), &clicks);
+  g_assert_cmpstr (gtk_button_get_label (GTK_BUTTON (button)), ==, "Tap to unlock");
+  g_assert_true (gtk_widget_get_can_focus (button));
+  gtk_widget_get_size_request (button, &width, &height);
+  g_assert_cmpint (width, >=, 200);
+  g_assert_cmpint (height, >=, 48);
+  gtk_button_clicked (GTK_BUTTON (button));
+  g_assert_cmpuint (clicks, ==, 1);
+  gtk_widget_destroy (button);
+  g_object_unref (button);
+}
+
+static void
+test_preference (void)
+{
+  g_unsetenv ("PINECONE_PHOSH_LAUNCHER");
+  g_unsetenv ("PINECONE_PHOSH_LIGHT_LOCKSCREEN");
+  g_assert_false (pinecone_light_lockscreen_enabled ());
+  g_setenv ("PINECONE_PHOSH_LAUNCHER", "1", TRUE);
+  g_assert_true (pinecone_light_lockscreen_enabled ());
+  g_setenv ("PINECONE_PHOSH_LIGHT_LOCKSCREEN", "0", TRUE);
+  g_assert_false (pinecone_light_lockscreen_enabled ());
+  g_setenv ("PINECONE_PHOSH_LIGHT_LOCKSCREEN", "invalid", TRUE);
+  g_assert_false (pinecone_light_lockscreen_enabled ());
+  g_setenv ("PINECONE_PHOSH_LIGHT_LOCKSCREEN", "1", TRUE);
+  g_assert_true (pinecone_light_lockscreen_enabled ());
+}
+
+int
+main (int argc, char **argv)
+{
+  gtk_test_init (&argc, &argv, NULL);
+  hdy_init ();
+  g_test_add_func ("/pinecone/lockscreen/button", test_button);
+  g_test_add_func ("/pinecone/lockscreen/preference", test_preference);
+  g_test_add_func ("/pinecone/lockscreen/static-transition", test_static_transition);
+  return g_test_run ();
+}
