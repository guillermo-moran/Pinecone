diff -ruN -x subprojects a/src/pinecone-lockscreen-policy.h b/src/pinecone-lockscreen-policy.h
--- a/src/pinecone-lockscreen-policy.h	1969-12-31 18:00:00
+++ b/src/pinecone-lockscreen-policy.h	2026-10-27 22:29:12
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <gtk/gtk.h>
+
+static inline gboolean
+pinecone_light_lockscreen_enabled (void)
+{
+  const char *value = g_getenv ("PINECONE_PHOSH_LIGHT_LOCKSCREEN");
+  if (value)
+    return g_strcmp0 (value, "1") == 0;
+  return g_strcmp0 (g_getenv ("PINECONE_PHOSH_LAUNCHER"), "1") == 0;
+}
+
+static inline GtkWidget *
+pinecone_lockscreen_create_unlock_button (void)
+{
+  GtkWidget *button = gtk_button_new_with_label ("Tap to unlock");
+  gtk_widget_set_name (button, "pinecone-tap-unlock");
+  gtk_button_set_image (GTK_BUTTON (button),
+                        gtk_image_new_from_icon_name ("changes-prevent-symbolic", GTK_ICON_SIZE_BUTTON));
+  gtk_button_set_always_show_image (GTK_BUTTON (button), TRUE);
+  gtk_widget_set_halign (button, GTK_ALIGN_CENTER);
+  gtk_widget_set_size_request (button, 200, 52);
+  gtk_widget_set_margin_bottom (button, 32);
+  gtk_widget_set_margin_top (button, 16);
+  return button;
+}
