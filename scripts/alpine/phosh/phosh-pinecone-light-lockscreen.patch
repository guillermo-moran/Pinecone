diff -ruN -x subprojects a/src/pinecone-launcher.c b/src/pinecone-launcher.c
--- a/src/pinecone-launcher.c	2026-10-27 21:45:08
+++ b/src/pinecone-launcher.c	2026-10-27 22:14:29
@@ -8,11 +8,60 @@
   GListModel *apps, *favorites;
   GListStore *home_items, *dock_items;
   GtkWidget *home, *dock, *empty, *count;
+  GtkIconTheme *icon_theme;
+  GPtrArray *warm_icons;
+  guint warm_idle, warm_index;
 };
 G_DEFINE_TYPE (PineconeLauncher, pinecone_launcher, GTK_TYPE_BOX)
 static guint app_launched;
 
+static gboolean
+prewarm_next_icon (gpointer data)
+{
+  PineconeLauncher *self = data;
+  guint dock_count = g_list_model_get_n_items (G_LIST_MODEL (self->dock_items));
+  guint count = dock_count + g_list_model_get_n_items (G_LIST_MODEL (self->home_items));
+  guint index = self->warm_index++;
+  gboolean dock = index < dock_count;
+  g_autoptr (GAppInfo) app = NULL;
+  g_autoptr (GtkIconInfo) info = NULL;
+  g_autoptr (GdkPixbuf) pixels = NULL;
+  GIcon *icon;
+
+  if (index >= MIN (count, 32)) {
+    self->warm_idle = 0;
+    return G_SOURCE_REMOVE;
+  }
+  app = g_list_model_get_item (G_LIST_MODEL (dock ? self->dock_items : self->home_items),
+                               dock ? index : index - dock_count);
+  icon = g_app_info_get_icon (app);
+  if (!icon)
+    return G_SOURCE_CONTINUE;
+  info = gtk_icon_theme_lookup_by_gicon_for_scale (self->icon_theme, icon, dock ? 48 : 56,
+                                                  gtk_widget_get_scale_factor (GTK_WIDGET (self)),
+                                                  GTK_ICON_LOOKUP_FORCE_SIZE);
+  if (info)
+    pixels = gtk_icon_info_load_icon (info, NULL);
+  /* Retain GTK's cached icon info, not a second Home framebuffer. Each idle
+   * dispatch decodes at most one icon; input takes priority over preloading. */
+  if (pixels)
+    g_ptr_array_add (self->warm_icons, g_steal_pointer (&info));
+  return G_SOURCE_CONTINUE;
+}
+
 static void
+schedule_prewarm (PineconeLauncher *self)
+{
+  g_clear_handle_id (&self->warm_idle, g_source_remove);
+  g_ptr_array_set_size (self->warm_icons, 0);
+  self->warm_index = 0;
+  if (g_strcmp0 (g_getenv ("PINECONE_PHOSH_HOME_PREWARM"), "0") == 0)
+    return;
+  self->warm_idle = g_idle_add_full (G_PRIORITY_LOW, prewarm_next_icon, self, NULL);
+  g_source_set_name_by_id (self->warm_idle, "[PineconeLauncher] preload Home icons");
+}
+
+static void
 on_app_launched (GtkWidget *button, GAppInfo *info, PineconeLauncher *self)
 {
   g_signal_emit (self, app_launched, 0, info);
@@ -118,6 +167,7 @@
   gtk_label_set_text (GTK_LABEL (self->count), count_text);
   gtk_widget_set_visible (self->dock, g_list_model_get_n_items (G_LIST_MODEL (self->dock_items)) > 0);
   gtk_widget_set_visible (self->empty, g_hash_table_size (seen) == 0);
+  schedule_prewarm (self);
 }
 
