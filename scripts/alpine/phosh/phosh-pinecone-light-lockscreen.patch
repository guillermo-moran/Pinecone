+  g_clear_object (&self->icon_theme);
+  g_clear_pointer (&self->warm_icons, g_ptr_array_unref);
   if (self->apps)
     g_signal_handlers_disconnect_by_data (self->apps, self);
   if (self->favorites)
@@ -173,6 +228,11 @@
