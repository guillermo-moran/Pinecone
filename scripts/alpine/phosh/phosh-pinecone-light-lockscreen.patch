 {
   GtkWidget *header, *heading, *scroll, *content;
+  self->warm_icons = g_ptr_array_new_with_free_func (g_object_unref);
+  self->icon_theme = g_object_ref (gtk_icon_theme_get_for_screen (gtk_widget_get_screen (GTK_WIDGET (self))));
+  g_signal_connect_object (self->icon_theme, "changed", G_CALLBACK (schedule_prewarm),
+                           self, G_CONNECT_SWAPPED);
+  g_signal_connect_swapped (self, "notify::scale-factor", G_CALLBACK (schedule_prewarm), self);
   gtk_orientable_set_orientation (GTK_ORIENTABLE (self), GTK_ORIENTATION_VERTICAL);
