diff -ruN -x subprojects a/tests/test-pinecone-launcher.c b/tests/test-pinecone-launcher.c
--- a/tests/test-pinecone-launcher.c	1969-12-31 18:00:00
+++ b/tests/test-pinecone-launcher.c	2026-10-26 19:03:38
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pinecone-launcher.h"
+#include "app-grid-button.h"
+#include "app-list-model.h"
+#include "overview.h"
+#include <glib/gstdio.h>
+#include <handy.h>
+
+static GtkWidget *
+find_named (GtkWidget *widget, const char *name)
+{
+  if (g_strcmp0 (gtk_widget_get_name (widget), name) == 0)
+    return widget;
+  if (GTK_IS_CONTAINER (widget)) {
+    g_autoptr (GList) children = gtk_container_get_children (GTK_CONTAINER (widget));
+    for (GList *l = children; l; l = l->next) {
+      GtkWidget *found = find_named (l->data, name);
+      if (found)
+        return found;
+    }
+  }
+  return NULL;
+}
+
+static guint
+child_count (GtkWidget *widget)
+{
+  g_autoptr (GList) children = gtk_container_get_children (GTK_CONTAINER (widget));
+  return g_list_length (children);
+}
+
+static void
+on_launched (PineconeLauncher *launcher, GAppInfo *info, GAppInfo **received)
+{
+  *received = info;
+}
+
+static void
+test_models (void)
+{
+  g_autoptr (GListStore) apps = g_list_store_new (G_TYPE_DESKTOP_APP_INFO);
+  g_autoptr (GListStore) favorites = g_list_store_new (G_TYPE_DESKTOP_APP_INFO);
+  g_autofree char *dir = g_dir_make_tmp ("pinecone-launcher-test-XXXXXX", NULL);
+  GtkWidget *launcher, *home, *dock;
+  GAppInfo *received = NULL;
+  GAppInfo *info;
+  GtkFlowBoxChild *button;
+  int minimum, natural;
+
+  for (guint i = 0; i < 6; i++) {
+    g_autofree char *file = g_strdup_printf ("%s/app%u.desktop", dir, i);
+    g_autofree char *contents = g_strdup_printf (
+      "[Desktop Entry]\nType=Application\nName=Test %u\nExec=/bin/true\nIcon=utilities-terminal\n", i);
+    g_autoptr (GDesktopAppInfo) info = NULL;
+    g_assert_true (g_file_set_contents (file, contents, -1, NULL));
+    info = g_desktop_app_info_new_from_filename (file);
+    g_assert_nonnull (info);
+    g_list_store_append (apps, info);
+    g_list_store_append (favorites, info);
+    g_remove (file);
+  }
+  g_rmdir (dir);
+  launcher = pinecone_launcher_new (G_LIST_MODEL (apps), G_LIST_MODEL (favorites));
+  g_object_ref_sink (launcher);
+  home = find_named (launcher, "pinecone-home-grid");
+  dock = find_named (launcher, "pinecone-dock");
+  g_assert_nonnull (home);
+  g_assert_nonnull (dock);
+  g_assert_cmpuint (child_count (dock), ==, 4);
+  g_assert_cmpuint (child_count (home), ==, 2);
+
+  /* Favorites update without rereading desktop files; no duplicate icons. */
+  g_list_store_remove_all (favorites);
+  g_assert_cmpuint (child_count (home), ==, 6);
+  g_assert_false (gtk_widget_get_visible (dock));
+  g_list_store_remove (apps, 5);
+  g_assert_cmpuint (child_count (home), ==, 5);
+
+  button = gtk_flow_box_get_child_at_index (GTK_FLOW_BOX (home), 0);
+  info = phosh_app_grid_button_get_app_info (PHOSH_APP_GRID_BUTTON (button));
+  g_signal_connect (launcher, "app-launched", G_CALLBACK (on_launched), &received);
+  g_signal_emit_by_name (button, "app-launched", info);
+  g_assert_true (received == info);
+
+  /* Minimum size never forces horizontal overflow on a 320px display. */
+  gtk_widget_get_preferred_width (launcher, &minimum, &natural);
+  g_assert_cmpint (minimum, <=, 320);
+  gtk_widget_destroy (launcher);
+  g_object_unref (launcher);
+  g_list_store_remove_all (apps); /* Destruction disconnected model callbacks. */
+}
+
+static void
+test_pages (void)
+{
+  GtkWidget *overview = phosh_overview_new ();
+  GtkWidget *launcher = find_named (overview, "PineconeLauncher");
+  GtkWidget *grid = GTK_WIDGET (phosh_overview_get_app_grid (PHOSH_OVERVIEW (overview)));
+  GtkWidget *library = gtk_widget_get_parent (grid);
+  g_assert_nonnull (launcher);
+  g_assert_true (gtk_widget_get_visible (launcher));
+  g_assert_false (gtk_widget_get_visible (library));
+  phosh_overview_show_page (PHOSH_OVERVIEW (overview), PHOSH_OVERVIEW_PAGE_APPS);
+  g_assert_false (gtk_widget_get_visible (launcher));
+  g_assert_true (gtk_widget_get_visible (library));
+  phosh_overview_show_page (PHOSH_OVERVIEW (overview), PHOSH_OVERVIEW_PAGE_RECENT);
+  g_assert_false (gtk_widget_get_visible (launcher));
+  g_assert_false (gtk_widget_get_visible (library));
+  phosh_overview_show_page (PHOSH_OVERVIEW (overview), PHOSH_OVERVIEW_PAGE_HOME);
+  g_assert_true (gtk_widget_get_visible (launcher));
+  gtk_widget_destroy (overview);
+}
+
+static void
+test_complete_discovery (void)
+{
+  g_autoptr (PhoshAppListModel) model = g_object_new (PHOSH_TYPE_APP_LIST_MODEL, NULL);
+  gint64 deadline = g_get_monotonic_time () + 5 * G_TIME_SPAN_SECOND;
+  gboolean found = FALSE;
+
+  phosh_app_list_model_ensure_complete (model);
+  while (g_list_model_get_n_items (G_LIST_MODEL (model)) == 0 &&
+         g_get_monotonic_time () < deadline) {
+    g_main_context_iteration (NULL, FALSE);
+    g_usleep (1000);
+  }
+  for (guint i = 0; i < g_list_model_get_n_items (G_LIST_MODEL (model)); i++) {
+    g_autoptr (GAppInfo) info = g_list_model_get_item (G_LIST_MODEL (model), i);
+    if (g_strcmp0 (g_app_info_get_id (info), "demo.app.Second.desktop") == 0)
+      found = TRUE;
+  }
+  g_assert_true (found); /* This app is deliberately absent from the boot manifest. */
+}
+
+int
+main (int argc, char **argv)
+{
+  g_autofree char *dir = g_dir_make_tmp ("pinecone-manifest-test-XXXXXX", NULL);
+  g_autofree char *manifest = g_build_filename (dir, "apps.list", NULL);
+  int result;
+  g_assert_true (g_file_set_contents (manifest, "demo.app.First.desktop\n", -1, NULL));
+  g_setenv ("PINECONE_PHOSH_LAUNCHER", "1", TRUE);
+  g_setenv ("PINECONE_PHOSH_APP_MANIFEST", manifest, TRUE);
+  gtk_test_init (&argc, &argv, NULL);
+  hdy_init ();
+  g_test_add_func ("/pinecone/launcher/models", test_models);
+  g_test_add_func ("/pinecone/launcher/pages", test_pages);
+  g_test_add_func ("/pinecone/launcher/complete-discovery", test_complete_discovery);
+  result = g_test_run ();
+  g_remove (manifest);
+  g_rmdir (dir);
+  return result;
+}
