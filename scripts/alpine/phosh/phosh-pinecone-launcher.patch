diff -ruN -x subprojects a/src/pinecone-launcher.c b/src/pinecone-launcher.c
--- a/src/pinecone-launcher.c	1969-12-31 18:00:00
+++ b/src/pinecone-launcher.c	2026-10-26 18:55:51
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pinecone-launcher.h"
+#include "app-grid-button.h"
+#include "folder-info.h"
+
+struct _PineconeLauncher {
+  GtkBox parent;
+  GListModel *apps, *favorites;
+  GListStore *home_items, *dock_items;
+  GtkWidget *home, *dock, *empty;
+};
+G_DEFINE_TYPE (PineconeLauncher, pinecone_launcher, GTK_TYPE_BOX)
+static guint app_launched;
+
+static void
+on_app_launched (GtkWidget *button, GAppInfo *info, PineconeLauncher *self)
+{
+  g_signal_emit (self, app_launched, 0, info);
+}
+
+static GtkWidget *
+create_button (gpointer item, gpointer data)
+{
+  GtkWidget *button = phosh_app_grid_button_new (G_APP_INFO (item));
+  gtk_widget_set_tooltip_text (button, g_app_info_get_display_name (item));
+  g_signal_connect_object (button, "app-launched", G_CALLBACK (on_app_launched), data, 0);
+  gtk_widget_show (button);
+  return button;
+}
+
+static gint
+compare_apps (gconstpointer a, gconstpointer b, gpointer data)
+{
+  return g_utf8_collate (g_app_info_get_display_name (G_APP_INFO ((gpointer)a)),
+                         g_app_info_get_display_name (G_APP_INFO ((gpointer)b)));
+}
+
+static GtkWidget *
+create_dock_button (gpointer item, gpointer data)
+{
+  GtkWidget *button = create_button (item, data);
+  GtkWidget *clamp = gtk_bin_get_child (GTK_BIN (button));
+  GtkWidget *icon = phosh_app_grid_base_button_get_child (PHOSH_APP_GRID_BASE_BUTTON (button));
+  g_object_set (clamp, "width-request", 64, "natural-size", 64, NULL);
+  gtk_image_set_pixel_size (GTK_IMAGE (icon), 48);
+  return button;
+}
+
+static void
+append_app (GListStore *store, GHashTable *seen, GAppInfo *info)
+{
+  const char *id = g_app_info_get_id (info);
+  if (!G_IS_DESKTOP_APP_INFO (info) || !id || !g_app_info_should_show (info) ||
+      g_hash_table_contains (seen, id))
+    return;
+  g_hash_table_add (seen, g_strdup (id));
+  g_list_store_append (store, info);
+}
+
+static void
+rebuild (PineconeLauncher *self)
+{
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  g_list_store_remove_all (self->dock_items);
+  g_list_store_remove_all (self->home_items);
+
+  /* First four favorites form the dock; overflow stays on Home. */
+  for (guint i = 0; i < g_list_model_get_n_items (self->favorites); i++) {
+    g_autoptr (GAppInfo) info = g_list_model_get_item (self->favorites, i);
+    GListStore *target = g_list_model_get_n_items (G_LIST_MODEL (self->dock_items)) < 4 ?
+      self->dock_items : self->home_items;
+    append_app (target, seen, info);
+  }
+  for (guint i = 0; i < g_list_model_get_n_items (self->apps); i++) {
+    g_autoptr (GAppInfo) info = g_list_model_get_item (self->apps, i);
+    if (PHOSH_IS_FOLDER_INFO (info)) {
+      GListModel *children = phosh_folder_info_get_app_infos (PHOSH_FOLDER_INFO (info));
+      for (guint j = 0; j < g_list_model_get_n_items (children); j++) {
+        g_autoptr (GAppInfo) child = g_list_model_get_item (children, j);
+        append_app (self->home_items, seen, child);
+      }
+    } else {
+      append_app (self->home_items, seen, info);
+    }
+  }
+  g_list_store_sort (self->home_items, compare_apps, NULL);
+  gtk_widget_set_visible (self->dock, g_list_model_get_n_items (G_LIST_MODEL (self->dock_items)) > 0);
+  gtk_widget_set_visible (self->empty, g_list_model_get_n_items (G_LIST_MODEL (self->home_items)) == 0);
+}
+
+static void
+on_items_changed (GListModel *model, guint position, guint removed, guint added,
+                  PineconeLauncher *self)
+{
+  rebuild (self);
+}
+
+static GtkWidget *
+new_grid (GListModel *model, PineconeLauncher *self, gboolean dock)
+{
+  GtkWidget *grid = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (grid), GTK_SELECTION_NONE);
+  gtk_flow_box_set_activate_on_single_click (GTK_FLOW_BOX (grid), FALSE);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (grid), TRUE);
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (grid), dock ? 4 : 1);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (grid), 4);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (grid), 16);
+  gtk_flow_box_set_column_spacing (GTK_FLOW_BOX (grid), 4);
+  gtk_widget_set_valign (grid, GTK_ALIGN_START);
+  gtk_flow_box_bind_model (GTK_FLOW_BOX (grid), model,
+                           dock ? create_dock_button : create_button, self, NULL);
+  gtk_widget_show (grid);
+  return grid;
+}
+
+static void
+pinecone_launcher_dispose (GObject *object)
+{
+  PineconeLauncher *self = PINECONE_LAUNCHER (object);
+  if (self->apps)
+    g_signal_handlers_disconnect_by_data (self->apps, self);
+  if (self->favorites)
+    g_signal_handlers_disconnect_by_data (self->favorites, self);
+  g_clear_object (&self->apps);
+  g_clear_object (&self->favorites);
+  g_clear_object (&self->home_items);
+  g_clear_object (&self->dock_items);
+  G_OBJECT_CLASS (pinecone_launcher_parent_class)->dispose (object);
+}
+
+static void
+pinecone_launcher_class_init (PineconeLauncherClass *klass)
+{
+  G_OBJECT_CLASS (klass)->dispose = pinecone_launcher_dispose;
+  gtk_widget_class_set_css_name (GTK_WIDGET_CLASS (klass), "pinecone-launcher");
+  app_launched = g_signal_new ("app-launched", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
+                               0, NULL, NULL, NULL, G_TYPE_NONE, 1, G_TYPE_APP_INFO);
+}
+
+static void
+pinecone_launcher_init (PineconeLauncher *self)
+{
+  GtkWidget *heading, *scroll, *content;
+  gtk_orientable_set_orientation (GTK_ORIENTABLE (self), GTK_ORIENTATION_VERTICAL);
+  gtk_widget_set_vexpand (GTK_WIDGET (self), TRUE);
+  self->home_items = g_list_store_new (G_TYPE_DESKTOP_APP_INFO);
+  self->dock_items = g_list_store_new (G_TYPE_DESKTOP_APP_INFO);
+  heading = gtk_label_new ("Pinecone");
+  gtk_label_set_xalign (GTK_LABEL (heading), 0);
+  gtk_widget_set_name (heading, "pinecone-launcher-title");
+  gtk_box_pack_start (GTK_BOX (self), heading, FALSE, FALSE, 0);
+  scroll = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll), GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_box_pack_start (GTK_BOX (self), scroll, TRUE, TRUE, 0);
+  content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_container_add (GTK_CONTAINER (scroll), content);
+  self->home = new_grid (G_LIST_MODEL (self->home_items), self, FALSE);
+  gtk_widget_set_name (self->home, "pinecone-home-grid");
+  gtk_box_pack_start (GTK_BOX (content), self->home, FALSE, FALSE, 0);
+  self->empty = gtk_label_new ("No other applications installed");
+  gtk_label_set_line_wrap (GTK_LABEL (self->empty), TRUE);
+  gtk_box_pack_start (GTK_BOX (content), self->empty, FALSE, FALSE, 16);
+  self->dock = new_grid (G_LIST_MODEL (self->dock_items), self, TRUE);
+  gtk_widget_set_name (self->dock, "pinecone-dock");
+  gtk_box_pack_end (GTK_BOX (self), self->dock, FALSE, FALSE, 0);
+  gtk_widget_show_all (GTK_WIDGET (self));
+}
+
+GtkWidget *
+pinecone_launcher_new (GListModel *apps, GListModel *favorites)
+{
+  PineconeLauncher *self;
+  g_return_val_if_fail (G_IS_LIST_MODEL (apps), NULL);
+  g_return_val_if_fail (G_IS_LIST_MODEL (favorites), NULL);
+  self = g_object_new (PINECONE_TYPE_LAUNCHER, NULL);
+  self->apps = g_object_ref (apps);
+  self->favorites = g_object_ref (favorites);
+  g_signal_connect_object (apps, "items-changed", G_CALLBACK (on_items_changed), self, 0);
+  g_signal_connect_object (favorites, "items-changed", G_CALLBACK (on_items_changed), self, 0);
+  rebuild (self);
+  return GTK_WIDGET (self);
+}
