 static void
+update_items (GListStore *store, GListModel *next)
+{
+  guint old_count = g_list_model_get_n_items (G_LIST_MODEL (store));
+  guint new_count = g_list_model_get_n_items (next);
+  guint prefix = 0, suffix = 0;
+  g_autoptr (GPtrArray) added = g_ptr_array_new_with_free_func (g_object_unref);
+
+  /* Retain identical widgets at both ends and emit a single middle splice. */
+  while (prefix < MIN (old_count, new_count)) {
+    g_autoptr (GObject) old = g_list_model_get_item (G_LIST_MODEL (store), prefix);
+    g_autoptr (GObject) item = g_list_model_get_item (next, prefix);
+    if (old != item)
+      break;
+    prefix++;
+  }
+  while (suffix < MIN (old_count, new_count) - prefix) {
+    g_autoptr (GObject) old = g_list_model_get_item (G_LIST_MODEL (store), old_count - suffix - 1);
+    g_autoptr (GObject) item = g_list_model_get_item (next, new_count - suffix - 1);
+    if (old != item)
+      break;
+    suffix++;
+  }
+  for (guint i = prefix; i < new_count - suffix; i++)
+    g_ptr_array_add (added, g_list_model_get_item (next, i));
+  if (old_count - prefix - suffix || added->len)
+    g_list_store_splice (store, prefix, old_count - prefix - suffix, added->pdata, added->len);
+}
