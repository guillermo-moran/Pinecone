b493ff6b1be35a659400abeaa90e0870ae1d91d1191fbbfdff21adb47b580406f602bc17a550f30ea15c2ba7d0936d1778d55a3afe41d3e630279f937a98cc5c  phoc-pinecone-layout.patch
bb9af5905b8240760a1330a9da849f22db257f80e2ea855b005029bbbdb0e2165937ddc55fc0355b2728a382bd8765135f4486006c6944c7f7f9611e02f89d16  phoc-pinecone-interactions.patch
3d6f04c77b8c005e5bd18efc35e323451c3e55c6cbf3be35adb20e1323b2edbec15df44e10da87e06f20e573492b0803dd705b1521e782c1cc3684462db72ef2  wlroots-pinecone-0.20.2.patch.embed
